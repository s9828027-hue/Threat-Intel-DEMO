# Copy this file to .env for local development (never commit the real .env).
# On Render/etc, set these as dashboard environment variables instead.

# --- Required ---
# Signing key for approval tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_SECRET_KEY=change-me-to-a-random-value

# Public base URL this app is reachable at (used to build approve/reject/publish links)
APPROVAL_API_BASE_URL=http://127.0.0.1:5000

# --- Demo vs. real firewall ---
# true  = use adapters/mock_scm.py, no real firewall/API is contacted (safe default)
# false = use adapters/scm_write.py against a REAL Palo Alto SCM tenant (see below)
THREATGATE_DEMO_MODE=true

# --- Optional: public threat-intel feed keys (free registration) ---
# Without these, ThreatFox/URLhaus/OTX are skipped and the pipeline still runs
# fine on Feodo Tracker + Spamhaus DROP alone.
ABUSECH_AUTH_KEY=
OTX_API_KEY=

# --- Optional: Google Chat webhook notifications ---
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_CHAT_SUPERVISOR_WEBHOOK_URL=

# --- Optional: tuning ---
ESCALATION_THRESHOLD=500
PIPELINE_INTERVAL_MINUTES=60

# --- Only used when THREATGATE_DEMO_MODE=false, i.e. a REAL deployment ---
# Your organization's own public IP ranges, so the pipeline never blocks your
# own traffic. Example: ORG_OWN_RANGES_JSON=["203.0.113.0/24","198.51.100.128/25"]
ORG_OWN_RANGES_JSON=
SCM_CLIENT_ID=
SCM_CLIENT_SECRET=
SCM_TSG_ID=
SCM_FOLDER=Shared
EDL_NAME=ThreatGate-Blocklist
EDL_SOURCE_URL=http://CHANGE-ME:5000/edl/blocklist.txt
